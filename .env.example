# ==========================================
# MANAM Production API Environment Variables
# Domain: https://api.manammcare.com
# ==========================================

# Application Port & Mode
PORT=5000
NODE_ENV=development

# Production PostgreSQL Database Connection
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/manamm_db?schema=public"

# JWT Authentication
JWT_SECRET="manam_jwt_super_secret_key_production_2026_change_in_prod"
JWT_EXPIRES_IN="7d"

# Razorpay Payment Gateway (Server-side credentials)
# Public key is shared with mobile client; Secret key is NEVER shared.
RAZORPAY_KEY_ID="rzp_test_placeholder"
RAZORPAY_KEY_SECRET="rzp_test_secret_placeholder"

# CORS Allowed Origins (Comma-separated)
CLIENT_URL="http://localhost:5173,http://localhost:8081,http://localhost:19006,https://manammcare.com,https://www.manammcare.com,https://api.manammcare.com"

# Swagger Documentation
ENABLE_SWAGGER=true
