{
  "title": "MANAMM Mobile Application REST API Contract",
  "version": "1.0.0",
  "baseUrl": "https://api.manammcare.com",
  "authScheme": "Bearer JWT",
  "standardResponses": {
    "success": {
      "success": true,
      "data": {},
      "message": "Success message"
    },
    "list": {
      "success": true,
      "data": [],
      "pagination": {
        "page": 1,
        "limit": 20,
        "total": 100,
        "totalPages": 5
      }
    },
    "error": {
      "success": false,
      "message": "User-friendly localized error message",
      "code": "ERROR_CODE"
    }
  },
  "endpoints": {
    "auth": [
      {
        "method": "POST",
        "path": "/api/auth/register",
        "description": "Register a new customer account",
        "requestBody": {
          "fullName": "string",
          "email": "string",
          "phone": "string",
          "password": "string (min 6 characters)"
        },
        "response": {
          "user": "User",
          "token": "string (JWT)",
          "refreshToken": "string"
        }
      },
      {
        "method": "POST",
        "path": "/api/auth/login",
        "description": "Authenticate user credentials and receive JWT session",
        "requestBody": {
          "emailOrPhone": "string",
          "password": "string"
        },
        "response": {
          "user": "User",
          "token": "string (JWT)",
          "refreshToken": "string"
        }
      },
      {
        "method": "POST",
        "path": "/api/auth/logout",
        "description": "Invalidate current JWT session",
        "headers": { "Authorization": "Bearer <token>" },
        "response": { "success": true }
      },
      {
        "method": "GET",
        "path": "/api/auth/me",
        "description": "Get current authenticated user profile and permissions",
        "headers": { "Authorization": "Bearer <token>" },
        "response": { "user": "User" }
      }
    ],
    "users": [
      {
        "method": "GET",
        "path": "/api/users/me",
        "description": "Retrieve customer profile details",
        "headers": { "Authorization": "Bearer <token>" },
        "response": { "profile": "UserProfile" }
      },
      {
        "method": "PATCH",
        "path": "/api/users/me",
        "description": "Update customer personal and contact details",
        "headers": { "Authorization": "Bearer <token>" },
        "requestBody": {
          "firstName": "string?",
          "lastName": "string?",
          "phone": "string?",
          "profileImage": "string?"
        },
        "response": { "profile": "UserProfile" }
      },
      {
        "method": "GET",
        "path": "/api/users/me/addresses",
        "description": "List all saved customer delivery addresses",
        "headers": { "Authorization": "Bearer <token>" },
        "response": { "addresses": "Address[]" }
      },
      {
        "method": "POST",
        "path": "/api/users/me/addresses",
        "description": "Create a new delivery address",
        "headers": { "Authorization": "Bearer <token>" },
        "requestBody": {
          "type": "HOME | WORK | OTHER",
          "label": "string?",
          "name": "string",
          "phone": "string",
          "addressLine1": "string",
          "addressLine2": "string?",
          "city": "string",
          "state": "string",
          "postalCode": "string",
          "country": "India",
          "landmark": "string?",
          "isDefault": "boolean"
        },
        "response": { "address": "Address" }
      },
      {
        "method": "PATCH",
        "path": "/api/users/me/addresses/:id",
        "description": "Update an existing delivery address",
        "headers": { "Authorization": "Bearer <token>" },
        "response": { "address": "Address" }
      },
      {
        "method": "DELETE",
        "path": "/api/users/me/addresses/:id",
        "description": "Delete a delivery address",
        "headers": { "Authorization": "Bearer <token>" },
        "response": { "success": true }
      }
    ],
    "products": [
      {
        "method": "GET",
        "path": "/api/products",
        "description": "Query paginated catalog of active products with filters",
        "queryParams": {
          "page": "number (default 1)",
          "limit": "number (default 20)",
          "categoryId": "string?",
          "brandId": "string?",
          "search": "string?",
          "minPrice": "number?",
          "maxPrice": "number?",
          "isFeatured": "boolean?",
          "sortBy": "price_asc | price_desc | newest | popularity",
          "inStockOnly": "boolean?"
        },
        "response": { "items": "Product[]", "pagination": "Pagination" }
      },
      {
        "method": "GET",
        "path": "/api/products/:id",
        "description": "Retrieve single product details by ID or slug",
        "response": { "product": "Product" }
      },
      {
        "method": "GET",
        "path": "/api/products/featured",
        "description": "Retrieve curated featured products",
        "response": { "products": "Product[]" }
      },
      {
        "method": "GET",
        "path": "/api/products/search",
        "description": "Search products with autocomplete matches",
        "queryParams": { "q": "string" },
        "response": { "products": "Product[]" }
      },
      {
        "method": "GET",
        "path": "/api/categories",
        "description": "Retrieve list of all active categories",
        "response": { "categories": "Category[]" }
      },
      {
        "method": "GET",
        "path": "/api/categories/:id/products",
        "description": "Retrieve paginated products for specific category",
        "queryParams": { "page": "number", "limit": "number" },
        "response": { "items": "Product[]", "pagination": "Pagination" }
      }
    ],
    "cart": [
      {
        "method": "GET",
        "path": "/api/cart",
        "description": "Retrieve current authenticated user active cart",
        "headers": { "Authorization": "Bearer <token>" },
        "response": { "cart": "Cart" }
      },
      {
        "method": "POST",
        "path": "/api/cart/items",
        "description": "Add product to cart or increment quantity",
        "headers": { "Authorization": "Bearer <token>" },
        "requestBody": { "productId": "string", "quantity": "number" },
        "response": { "cart": "Cart" }
      },
      {
        "method": "PATCH",
        "path": "/api/cart/items/:id",
        "description": "Update quantity of item in cart",
        "headers": { "Authorization": "Bearer <token>" },
        "requestBody": { "quantity": "number" },
        "response": { "cart": "Cart" }
      },
      {
        "method": "DELETE",
        "path": "/api/cart/items/:id",
        "description": "Remove item from cart",
        "headers": { "Authorization": "Bearer <token>" },
        "response": { "cart": "Cart" }
      },
      {
        "method": "DELETE",
        "path": "/api/cart",
        "description": "Clear all items from active cart",
        "headers": { "Authorization": "Bearer <token>" },
        "response": { "cart": "Cart" }
      }
    ],
    "orders": [
      {
        "method": "POST",
        "path": "/api/orders",
        "description": "Create a new order from current cart and delivery address",
        "headers": { "Authorization": "Bearer <token>" },
        "requestBody": {
          "addressId": "string",
          "couponCode": "string?",
          "paymentMethod": "razorpay | cod | upi"
        },
        "response": { "order": "Order" }
      },
      {
        "method": "GET",
        "path": "/api/orders",
        "description": "List authenticated user order history with pagination",
        "headers": { "Authorization": "Bearer <token>" },
        "queryParams": { "page": "number", "limit": "number", "status": "string?" },
        "response": { "orders": "Order[]", "pagination": "Pagination" }
      },
      {
        "method": "GET",
        "path": "/api/orders/:id",
        "description": "Get complete order details by orderId",
        "headers": { "Authorization": "Bearer <token>" },
        "response": { "order": "Order" }
      },
      {
        "method": "POST",
        "path": "/api/orders/:id/cancel",
        "description": "Cancel an order if still prior to shipment",
        "headers": { "Authorization": "Bearer <token>" },
        "requestBody": { "reason": "string?" },
        "response": { "order": "Order" }
      }
    ],
    "payments": [
      {
        "method": "POST",
        "path": "/api/payments/create-order",
        "description": "Create Razorpay server order with authoritative backend calculation",
        "headers": { "Authorization": "Bearer <token>" },
        "requestBody": { "orderId": "string" },
        "response": {
          "razorpayOrderId": "string",
          "amount": "number (in paise)",
          "currency": "INR",
          "keyId": "string (public client key)"
        }
      },
      {
        "method": "POST",
        "path": "/api/payments/verify",
        "description": "Cryptographically verify Razorpay signature on server",
        "headers": { "Authorization": "Bearer <token>" },
        "requestBody": {
          "orderId": "string",
          "razorpayOrderId": "string",
          "razorpayPaymentId": "string",
          "razorpaySignature": "string"
        },
        "response": { "paymentStatus": "SUCCESS", "order": "Order" }
      },
      {
        "method": "GET",
        "path": "/api/payments/:id",
        "description": "Get transaction receipt status",
        "headers": { "Authorization": "Bearer <token>" },
        "response": { "payment": "Payment" }
      }
    ],
    "coupons": [
      {
        "method": "POST",
        "path": "/api/coupons/validate",
        "description": "Validate coupon applicability against order subtotal",
        "requestBody": { "code": "string", "subtotal": "number", "userId": "string?" },
        "response": {
          "isValid": "boolean",
          "discountAmount": "number",
          "coupon": "Coupon",
          "message": "string"
        }
      }
    ],
    "notifications": [
      {
        "method": "GET",
        "path": "/api/notifications",
        "description": "Get customer in-app notifications with pagination",
        "headers": { "Authorization": "Bearer <token>" },
        "response": { "notifications": "AppNotification[]", "unreadCount": "number" }
      },
      {
        "method": "PATCH",
        "path": "/api/notifications/:id/read",
        "description": "Mark single notification as read",
        "headers": { "Authorization": "Bearer <token>" },
        "response": { "success": true }
      },
      {
        "method": "PATCH",
        "path": "/api/notifications/read-all",
        "description": "Mark all notifications as read",
        "headers": { "Authorization": "Bearer <token>" },
        "response": { "success": true }
      }
    ],
    "content": [
      {
        "method": "GET",
        "path": "/api/banners",
        "description": "Get active promotional banners",
        "response": { "banners": "Banner[]" }
      },
      {
        "method": "GET",
        "path": "/api/offers",
        "description": "Get active promotional offers",
        "response": { "offers": "Offer[]" }
      },
      {
        "method": "GET",
        "path": "/api/announcements",
        "description": "Get active system announcements",
        "response": { "announcements": "Announcement[]" }
      },
      {
        "method": "GET",
        "path": "/api/faqs",
        "description": "Get list of customer FAQs grouped by category",
        "response": { "faqs": "FAQ[]" }
      },
      {
        "method": "GET",
        "path": "/api/policies/:slug",
        "description": "Get policy markdown/html content by slug",
        "response": { "policy": "Policy" }
      }
    ],
    "admin": [
      {
        "method": "GET",
        "path": "/api/admin/dashboard",
        "description": "Aggregated metrics and key operational KPIs",
        "headers": { "Authorization": "Bearer <admin-token>" },
        "response": { "dashboard": "AdminDashboardData" }
      },
      {
        "method": "GET",
        "path": "/api/admin/products",
        "description": "Query all products with inventory levels",
        "headers": { "Authorization": "Bearer <admin-token>" },
        "response": { "products": "Product[]", "pagination": "Pagination" }
      },
      {
        "method": "POST",
        "path": "/api/admin/products",
        "description": "Create new product in catalog",
        "headers": { "Authorization": "Bearer <admin-token>" },
        "requestBody": { "product": "ProductInput" },
        "response": { "product": "Product" }
      },
      {
        "method": "PATCH",
        "path": "/api/admin/products/:id",
        "description": "Update product details or pricing",
        "headers": { "Authorization": "Bearer <admin-token>" },
        "requestBody": { "product": "Partial<ProductInput>" },
        "response": { "product": "Product" }
      },
      {
        "method": "DELETE",
        "path": "/api/admin/products/:id",
        "description": "Deactivate or delete product",
        "headers": { "Authorization": "Bearer <admin-token>" },
        "response": { "success": true }
      },
      {
        "method": "GET",
        "path": "/api/admin/categories",
        "description": "List all categories with subcategory trees",
        "headers": { "Authorization": "Bearer <admin-token>" },
        "response": { "categories": "Category[]" }
      },
      {
        "method": "POST",
        "path": "/api/admin/categories",
        "description": "Create new product category",
        "headers": { "Authorization": "Bearer <admin-token>" },
        "response": { "category": "Category" }
      },
      {
        "method": "PATCH",
        "path": "/api/admin/categories/:id",
        "description": "Update category details",
        "headers": { "Authorization": "Bearer <admin-token>" },
        "response": { "category": "Category" }
      },
      {
        "method": "DELETE",
        "path": "/api/admin/categories/:id",
        "description": "Delete category",
        "headers": { "Authorization": "Bearer <admin-token>" },
        "response": { "success": true }
      },
      {
        "method": "GET",
        "path": "/api/admin/orders",
        "description": "Query all system orders with customer information",
        "headers": { "Authorization": "Bearer <admin-token>" },
        "queryParams": { "status": "string?", "page": "number", "limit": "number" },
        "response": { "orders": "Order[]", "pagination": "Pagination" }
      },
      {
        "method": "GET",
        "path": "/api/admin/orders/:id",
        "description": "Get detailed order info for admin processing",
        "headers": { "Authorization": "Bearer <admin-token>" },
        "response": { "order": "Order" }
      },
      {
        "method": "PATCH",
        "path": "/api/admin/orders/:id/status",
        "description": "Update order status (PROCESSING, SHIPPED, DELIVERED, CANCELLED)",
        "headers": { "Authorization": "Bearer <admin-token>" },
        "requestBody": { "status": "OrderStatus" },
        "response": { "order": "Order" }
      },
      {
        "method": "GET",
        "path": "/api/admin/users",
        "description": "Query system users with role and status filters",
        "headers": { "Authorization": "Bearer <admin-token>" },
        "response": { "users": "User[]", "pagination": "Pagination" }
      },
      {
        "method": "GET",
        "path": "/api/admin/users/:id",
        "description": "Get user profile and activity overview",
        "headers": { "Authorization": "Bearer <admin-token>" },
        "response": { "user": "User", "orders": "Order[]" }
      }
    ]
  }
}
